<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <OutputName>VortexModLists-Setup</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\publish\installer\</OutputPath>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildProjectDirectory)\..\..\publish\installer\VortexModLists.msi</MsiPath>
    <DotNetDesktopRuntimePath Condition="'$(DotNetDesktopRuntimePath)' == ''">$(MSBuildProjectDirectory)\..\..\publish\installer\windowsdesktop-runtime-10.0.0-win-x64.exe</DotNetDesktopRuntimePath>
    <DefineConstants>MsiPath=$(MsiPath);DotNetDesktopRuntimePath=$(DotNetDesktopRuntimePath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
