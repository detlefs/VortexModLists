<Window x:Class="VortexModLists.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        Icon="/Assets/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Assets/app.ico" Width="32" Height="32" Margin="0,0,12,0" />
            <TextBlock x:Name="AppNameTextBlock" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="AuthorTextBlock" Margin="0,0,0,6" />
            <TextBlock x:Name="VersionTextBlock" Margin="0,0,0,6" />
            <TextBlock x:Name="CopyrightTextBlock" Margin="0,0,0,12" />
            <Button Width="90" HorizontalAlignment="Right" IsDefault="True" Click="CloseButton_Click">OK</Button>
        </StackPanel>
    </Grid>
</Window>
